# Copy to .env for local use. NEVER commit real values. On Render set these in the dashboard (see DEPLOYMENT.md).

# --- required in production -------------------------------------------------
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/eventflow
MONGODB_DATABASE=eventflow
OCCAVIE_PUBLIC_URL=https://your-app.onrender.com
# 32+ random characters each, and different from each other: openssl rand -base64 36
OCCAVIE_REMEMBER_KEY=replace-with-a-long-random-secret
OCCAVIE_TICKET_SECRET=replace-with-a-different-long-random-secret

# --- first administrator (first start only; remove the password afterwards) --
OCCAVIE_BOOTSTRAP_ADMIN_EMAIL=
OCCAVIE_BOOTSTRAP_ADMIN_PASSWORD=

# --- optional ---------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod            # leave unset locally to get the demo accounts and seed data
OCCAVIE_EMAIL_PROVIDER=none            # "resend" enables email (also needed for password-reset links)
RESEND_API_KEY=
OCCAVIE_EMAIL_FROM=Occavie <events@your-verified-domain>
OCCAVIE_JOBS_TOKEN=replace-with-a-long-random-token   # enables POST /internal/jobs/run for an external scheduler
OCCAVIE_APPROVAL_REQUIRED=false        # true: new events wait for admin approval
OCCAVIE_EVENT_TIMEZONE=Asia/Dhaka
OCCAVIE_COUPON_ACCEPT_ANY=true        # demo: any coupon code gives 10% off; false = only real coupons
OCCAVIE_SAMPLE_EVENTS=true             # fill an empty database with sample events on first start
OCCAVIE_CONTACT_EMAIL=
OCCAVIE_CONTACT_WHATSAPP=
